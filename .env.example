# 复制为 .env，再在自己的电脑中填写。请勿把真实密钥提交到 GitHub。
# 不需要 AI 时，无需创建 .env，直接使用灵感模板。
LLM_API_KEY=
# 填写兼容 Chat Completions 的模型服务基础地址（通常以 /v1 结尾）。
LLM_BASE_URL=https://api.openai.com/v1
# 填写你有权限使用的模型名称，例如 gpt-4o-mini；本程序不指定默认模型。
LLM_MODEL=
# 如果模型服务不支持 JSON mode，可改成 false。
LLM_JSON_MODE=true
# 最多等待模型响应的毫秒数，允许 1000～180000。
LLM_TIMEOUT_MS=45000
